# Base URL of the FoodOnTheGo API (never a literal in a component).
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
# api = sign in against the backend; mock = in-browser development mock (tests and share builds always use mock).
VITE_AUTH_MODE=api
# LOCAL DEVELOPMENT ONLY: the backend's fixed test code (OTP_DEV_CODE), shown on the OTP screen so testers can sign in.
# Leave empty for staging / production builds.
VITE_DEV_OTP=
# api = markets, cities, service areas and corridors come from the backend; mock = development fixtures.
VITE_MARKET_MODE=api
# api = restaurants, opening hours, pickup settings and restaurant staff come from the backend; mock = development fixtures.
# Use together with VITE_MARKET_MODE=api and VITE_AUTH_MODE=api. Menus, orders, reviews and analytics stay development data.
VITE_RESTAURANT_MODE=api

# api = places, routes and restaurants along a journey come from the backend (places + routing provider, PostGIS);
# mock = the in-browser development providers. Use together with VITE_RESTAURANT_MODE=api and VITE_MARKET_MODE=api.
VITE_JOURNEY_MODE=api

# api = the cart is the backend's (one per guest token or signed-in customer; prices, validation and issues are the server's);
# mock = the device-only development cart. Needs VITE_RESTAURANT_MODE=api (the items are the backend's menu items).
VITE_CART_MODE=api

# api = pickup times are the backend's (ASAP, scheduled slots, capacity state, recommendation and the validation of a chosen time —
# calculated on the server clock in the restaurant's time zone); mock = the in-browser development slot engine. Needs VITE_CART_MODE=api.
VITE_PICKUP_MODE=api


# api = checkout is the backend's (final validation of the cart and the pickup time, promotion, configured taxes and fees, the total,
# the legal documents to accept, the pickup-time hold and the payment preparation); mock = the in-browser development checkout.
# Needs VITE_CART_MODE=api and VITE_PICKUP_MODE=api. No payment provider is connected yet: the payment step stays a development mock.
VITE_CHECKOUT_MODE=api
# Module 30: api = the payment step is the backend's payment attempt (needs VITE_CHECKOUT_MODE=api): the provider's own window, backend verification.
# mock = the in-browser development payment of Module 12 (unit tests and share builds always use it). No provider key belongs in this file:
# the browser gets the provider's PUBLIC key id from the backend with each payment attempt.
VITE_PAYMENT_MODE=api
# Module 31: api = orders are the backend's (needs VITE_PAYMENT_MODE=api): created by the server from the verified payment, read by order
# number, tracked by polling until realtime arrives. mock = the in-browser development orders (unit tests and share builds always use it).
VITE_ORDER_MODE=api
