# FoodOnTheGo backend — environment template. Copy to .env and fill in LOCAL values only.
# Never commit .env. Never put staging / production credentials in a local file.
# Business code reads config/*.php, never env() directly.

# ---------------------------------------------------------------- APP
APP_NAME=FoodOnTheGo
# local | testing | staging | production
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_VERSION=local-dev
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Comma separated browser origins allowed by CORS (first one is used in e-mail links).
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
# ISO 3166-1 alpha-2 code of the market used when a request names none.
MARKET_DEFAULT_COUNTRY=IN

# ---------------------------------------------------------------- LOGGING
LOG_CHANNEL=stack
# single (text, local) | structured (JSON lines, staging / production)
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------- DATABASE (PostgreSQL + PostGIS only)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=foodonthego_local
DB_USERNAME=fotg_local
DB_PASSWORD=
DB_SSLMODE=prefer

# ---------------------------------------------------------------- REDIS (cache, queues, rate limits, locks — never durable business data)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ---------------------------------------------------------------- CACHE / QUEUE / SESSION
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Module 32 — realtime order tracking: Laravel Reverb (WebSocket) is the broadcaster. The app id / key / secret are
# LOCAL random values you make up (never a production credential); the key is public to clients, the secret is not.
# Tests run with BROADCAST_CONNECTION=null (phpunit.xml). Start the server with: php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8085
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8085
# Comma-separated HOSTS (no scheme, no port — Reverb matches the Origin header's host) allowed to open a WebSocket. "*" is never used.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
# Module 39 (config/security.php): extra Host headers the application answers (APP_URL's host is always trusted) and the
# load balancer addresses allowed to set X-Forwarded-* (empty = none). Locally both stay empty.
TRUSTED_HOSTS=
TRUSTED_PROXIES=
# Module 39: an administrator token unused for this many minutes is revoked (0 = off). PENDING BUSINESS APPROVAL.
AUTH_ADMIN_IDLE_MINUTES=60
# Module 39: restaurant staff see a customer's full name and phone while the order is open and this many hours after it
# ended; afterwards a shortened name and a masked phone. PENDING BUSINESS APPROVAL.
RESTAURANT_CONTACT_HOURS=24
# Module 39: largest API request body that is not a file upload (bytes); larger bodies are refused with 413.
SECURITY_MAX_BODY_BYTES=262144

# ---------------------------------------------------------------- API
API_PAGE_SIZE=25
API_PAGE_SIZE_MAX=100
API_IDEMPOTENCY_TTL_MINUTES=1440
# true only in local / testing: exposes per-dependency readiness at /api/v1/ready without authentication.
API_READINESS_PUBLIC=true
# Requests per minute — development defaults, tune per environment.
RATE_LIMIT_API=120
RATE_LIMIT_PASSWORD_RESET=5
RATE_LIMIT_OTP_IP=10
RATE_LIMIT_OTP_PHONE=3
# Module 39: OTP cost budgets — all numbers per hour, one number per day (PENDING BUSINESS APPROVAL). Local e2e suites need
# them raised (they sign the fixture customers in many times a day).
RATE_LIMIT_OTP_GLOBAL_PER_HOUR=600
RATE_LIMIT_OTP_PHONE_PER_DAY=10
RATE_LIMIT_SEARCH=60
RATE_LIMIT_AVAILABILITY=30
RATE_LIMIT_PAYMENT=10
RATE_LIMIT_ADMIN_SENSITIVE=20

# ---------------------------------------------------------------- OTP (customer phone sign-in)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
# Fixed code for local / testing only, and only while nothing real is sent (SMS_DRIVER=log, no WhatsApp). Ignored in staging and production even if set.
OTP_DEV_CODE=

# ---------------------------------------------------------------- IDENTITY / SESSIONS
# Access-token lifetime in minutes (one token = one signed-in device).
AUTH_TOKEN_TTL_CUSTOMER_MINUTES=43200
AUTH_TOKEN_TTL_RESTAURANT_MINUTES=720
AUTH_TOKEN_TTL_ADMIN_MINUTES=480
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_INVITATION_TTL_HOURS=72
AUTH_PASSWORD_RESET_TTL_MINUTES=30
# true = an account without MFA can sign in only to enrol (set true for admin outside local).
# Module 39: not set here on purpose — the default is OFF in local / testing and ON everywhere else. Set it only to override.
# AUTH_MFA_REQUIRED_ADMIN=
AUTH_MFA_REQUIRED_RESTAURANT=false
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
AUTH_MFA_CHALLENGE_MAX_ATTEMPTS=5
# Password for the restaurant / admin fixture accounts created by db:seed in local / testing only.
# Empty = no fixture accounts. Choose your own value locally; never set it outside local.
LOCAL_FIXTURE_PASSWORD=
# Optional password source for `php artisan admin:create` when it runs unattended.
ADMIN_BOOTSTRAP_PASSWORD=
RATE_LIMIT_OTP_VERIFY_IP=20
RATE_LIMIT_OTP_VERIFY_CHALLENGE=10
RATE_LIMIT_STAFF_LOGIN_IP=20
RATE_LIMIT_STAFF_LOGIN_IDENTITY=5
RATE_LIMIT_ADMIN_LOGIN_IP=10
RATE_LIMIT_ADMIN_LOGIN_IDENTITY=3
RATE_LIMIT_MFA_VERIFY=10

# ---------------------------------------------------------------- MAIL
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@foodonthego.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------- STORAGE
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------- PROVIDERS (not integrated yet — leave empty)
# SMS for one-time codes. SMS_DRIVER: log | msg91 | twofactor | twilio
#   log       = NO SMS is sent (masked audit line only). Local / testing only; refused in production.
#   msg91     = MSG91 (India). Template + DLT id + sender are set up in the MSG91 panel.
#   twofactor = 2Factor.in (India). Template approved in their panel.
#   twilio    = Twilio (global). Text comes from OTP_SMS_TEMPLATE and must match the DLT template in India.
# SMS_FALLBACK_DRIVER: optional second provider used when the first cannot deliver.
# Check with: php artisan otp:check      Real test message: php artisan otp:test <phone> [--channel=sms|whatsapp]
SMS_DRIVER=log
SMS_FALLBACK_DRIVER=
SMS_TIMEOUT=10
SMS_MSG91_AUTH_KEY=
SMS_MSG91_OTP_TEMPLATE_ID=
SMS_2FACTOR_API_KEY=
SMS_2FACTOR_TEMPLATE=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_MESSAGING_SERVICE_SID=
SMS_TWILIO_FROM=
OTP_SMS_TEMPLATE="Your FoodOnTheGo verification code is :code. It expires in :minutes minutes. Do not share it with anyone."
# ---- How the one-time code reaches the customer (cheapest first). Resend moves to the next channel.
#   sms           = SMS only (default)
#   whatsapp,sms  = WhatsApp first, SMS on resend or when WhatsApp cannot deliver
OTP_CHANNELS=sms
# WhatsApp Cloud API (Meta). Template = an approved AUTHENTICATION template with a copy-code button.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
# Truecaller one-tap verification (Android app). Empty = off.
TRUECALLER_CLIENT_ID=
# MAPS / PLACES / ROUTING
MAPS_DRIVER=
MAPS_BROWSER_KEY=
PLACES_DRIVER=
PLACES_API_KEY=
ROUTING_DRIVER=
ROUTING_API_KEY=
# Module 26 journeys: fake = deterministic development providers (refused in production), google = live. Policy bounds in config/journey.php.
JOURNEY_ALLOW_FAKE_PROVIDERS=
JOURNEY_CORRIDOR_DEFAULT_METERS=3000
JOURNEY_SHORTLIST_CAP=40
JOURNEY_DETOUR_DEFAULT_MAX_MINUTES=15
JOURNEY_TTL_MINUTES=30
# Module 27 carts: lifetimes after the last change (hours), grace before the cleanup closes an expired cart (hours),
# retention of closed carts (days), how long a guest token may start a new cart (days), bounds. See config/cart.php.
CART_GUEST_TTL_HOURS=168
CART_CUSTOMER_TTL_HOURS=720
CART_EXPIRED_GRACE_HOURS=24
CART_CLOSED_RETENTION_DAYS=30
CART_GUEST_TOKEN_TTL_DAYS=30
CART_MAX_LINES=50
CART_MAX_TOTAL_QUANTITY=0
# Module 28 pickup availability (platform values; what a restaurant decides is its own pickup configuration).
# Large orders: the first FREE_ITEMS units add nothing, every further ITEMS_PER_STEP units add MINUTES_PER_STEP,
# up to MAX_EXTRA_MINUTES (0 minutes per step = off). Arrival buffer: minutes added to a traveller's estimated
# arrival before a time is recommended. See config/pickup.php.
PICKUP_PREP_QUANTITY_FREE_ITEMS=10
PICKUP_PREP_QUANTITY_ITEMS_PER_STEP=10
PICKUP_PREP_QUANTITY_MINUTES_PER_STEP=5
PICKUP_PREP_QUANTITY_MAX_EXTRA_MINUTES=30
PICKUP_PREP_MAX_MINUTES=480
PICKUP_ARRIVAL_BUFFER_MINUTES=0
PICKUP_CAPACITY_LIMITED_SHARE=0.25
PICKUP_MAX_SLOTS=600
PICKUP_REVALIDATE_AFTER_SECONDS=60
# Module 29 checkout: how long a checkout that is not confirmed lives (minutes), how long a confirmed one — and the
# pickup time it holds — lives (minutes), retention of closed checkouts (days), order-note length. TEST tax / fee
# rules are NEVER applied in production (APP_ENV=production), whatever is set here; elsewhere they are applied unless
# CHECKOUT_ALLOW_TEST_RULES=false. No tax or fee rate is configured here or anywhere in the code: rules are created
# by an administrator per market. See config/checkout.php.
CHECKOUT_DRAFT_TTL_MINUTES=15
CHECKOUT_READY_TTL_MINUTES=10
CHECKOUT_CLOSED_RETENTION_DAYS=30
CHECKOUT_ORDER_NOTE_MAX_LENGTH=300
CHECKOUT_ALLOW_TEST_RULES=
CHECKOUT_METRICS_RETENTION_HOURS=48
RATE_LIMIT_CHECKOUT_READ=120
RATE_LIMIT_CHECKOUT_WRITE=30
RATE_LIMIT_PROMOTION_APPLY=10
# Legal documents a customer accepts at checkout: the version in force and its effective date (YYYY-MM-DD). The texts
# are DRAFTS pending business / legal approval; whether a market's text is approved is market configuration.
LEGAL_TERMS_VERSION=draft-2026-09
LEGAL_TERMS_EFFECTIVE_DATE=
LEGAL_PRIVACY_VERSION=draft-2026-09
LEGAL_PRIVACY_EFFECTIVE_DATE=
LEGAL_REFUND_VERSION=draft-2026-09
LEGAL_REFUND_EFFECTIVE_DATE=
# PAYMENTS (Module 30). PAYMENT_DRIVER: razorpay | fake | empty. Empty = payments unavailable (there is no fallback).
# "fake" moves no money, exists for tests and local development, and is ALWAYS refused in production.
PAYMENT_DRIVER=
PAYMENT_TIMEOUT=15
PAYMENT_ALLOW_FAKE_PROVIDER=
PAYMENT_ATTEMPT_TTL_MINUTES=15
PAYMENT_HOLD_GRACE_MINUTES=5
PAYMENT_MAX_ATTEMPTS_PER_CHECKOUT=5
PAYMENT_WINDOW_MINUTES=45
PAYMENT_ORDER_HANDOFF_MINUTES=30
PAYMENT_WEBHOOK_QUEUE=payments
PAYMENT_DISPLAY_NAME=FoodOnTheGo
PAYMENT_METRICS_RETENTION_HOURS=48
# RAZORPAY — TEST MODE ONLY in this module (a live key is refused). Server-side secrets: never in a client, never committed.
# RAZORPAY_KEY_ID is the only value a browser or an app may see. Webhook URL: POST /api/v1/webhooks/payments/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
RAZORPAY_CAPTURE=automatic
RAZORPAY_METHODS=
RATE_LIMIT_PAYMENT_READ=120
RATE_LIMIT_PAYMENT_WEBHOOK=600
# WEBSOCKET
WEBSOCKET_DRIVER=

# Notifications (Module 33). PUSH_DRIVER: fake (local, deterministic) | fcm (FCM HTTP v1 — FIREBASE_PROJECT_ID + FIREBASE_CREDENTIALS = absolute path of the
# git-ignored service-account JSON; never commit it) | off. EMAIL_NOTIFICATIONS_DRIVER: mail (Laravel mailer — MAIL_MAILER) | fake. SMS_NOTIFICATIONS_DRIVER: off | fake
# (no SMS provider is approved for notifications; the OTP SMS provider is separate). Nothing real is sent on a local machine.
PUSH_DRIVER=fake
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
FCM_RESTRICTED_PACKAGE_NAME=
EMAIL_NOTIFICATIONS_DRIVER=mail
SMS_NOTIFICATIONS_DRIVER=off
NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_DEFAULT_LOCALE=en-IN

# Refunds and cancellation (Module 35). Names only — no secret lives here. Refunds are sent through the payment provider configured above
# (PAYMENT_DRIVER / RAZORPAY_* — TEST MODE keys only on a development machine; never live keys).
# REFUND_AUTO_APPROVE_REASONS: comma-separated refund reasons the policy approves without a person (e.g. RESTAURANT_REJECTED).
# AUTO-REFUND POLICY = PENDING BUSINESS APPROVAL: leave empty — every refund then waits for an administrator with admin.refunds.approve.
REFUND_AUTO_APPROVE_REASONS=
# Upper limit of an automatic approval, in minor units of the payment's currency (empty = no limit).
REFUND_AUTO_APPROVE_MAX_MINOR=
# true = the administrator who asked for a refund cannot approve it.
# Module 39: not set here on purpose — the default is OFF in local / testing and ON everywhere else. Set it only to override.
# REFUND_FOUR_EYES=
REFUND_QUEUE=payments
REFUND_MAX_UNKNOWN_RESUBMITS=2
REFUND_METRICS_RETENTION_HOURS=48
# Customer cancellation = PENDING BUSINESS / LEGAL APPROVAL: keep it disabled until a policy is approved.
# STATUSES: order states a customer may cancel in. EFFECT: FULL_REFUND | NO_REFUND | MANUAL_REVIEW.
ORDER_CUSTOMER_CANCELLATION_ENABLED=false
ORDER_CUSTOMER_CANCELLATION_POLICY_VERSION=unapproved-draft
ORDER_CUSTOMER_CANCELLATION_STATUSES=WAITING_FOR_RESTAURANT
ORDER_CUSTOMER_CANCELLATION_EFFECT=MANUAL_REVIEW
RATE_LIMIT_ORDER_CANCEL=6
RATE_LIMIT_REFUND_ACTION=30

# FINANCE (Module 36): ledger, commission, restaurant settlements, payouts, reconciliation.
# NOTHING BELOW IS AN APPROVED COMMERCIAL, TAX OR LEGAL POLICY — each is the shape of a decision that is
# PENDING BUSINESS / FINANCE / TAX / LEGAL APPROVAL. No commission rate, tax rate or fee formula is configured here:
# commission lives in commission plans (TEST fixtures only on a development machine).
FINANCE_QUEUE=finance
# Who the tax collected on an order belongs to: UNASSIGNED (held, nobody's) | PLATFORM | RESTAURANT.
FINANCE_TAX_OWNER=UNASSIGNED
# Who a customer fee belongs to: PLATFORM | RESTAURANT.
FINANCE_FEE_OWNER=PLATFORM
# The restaurant's share of a SHARED promotion in basis points. Empty = undefined: such an order waits for a decision.
FINANCE_SHARED_PROMOTION_RESTAURANT_BPS=
# Who bears a completed refund, per refund reason: "REASON:RESTAURANT,REASON:PLATFORM,REASON:SHARED:5000".
# Empty = every refund waits for a finance decision (UNASSIGNED).
FINANCE_REFUND_LIABILITY=
FINANCE_HOLD_ON_PENDING_REFUND=true
FINANCE_HOLD_ON_DISPUTE=true
# Settlement cadence for development: DAILY | WEEKLY | MONTHLY. No production schedule was approved.
FINANCE_SETTLEMENT_CADENCE=WEEKLY
# No minimum payout was approved: empty.
FINANCE_MINIMUM_PAYOUT_MINOR=
# Module 39: not set here on purpose — the default is OFF in local / testing and ON everywhere else. Set it only to override.
# FINANCE_SETTLEMENT_FOUR_EYES=
FINANCE_SETTLEMENTS_SCHEDULED=false
# PAYOUT_DRIVER: fake | empty. "fake" moves no money and is refused in production. There is NO real payout adapter:
# LIVE PAYOUT = DISABLED (and no variable here can enable it).
PAYOUT_DRIVER=
PAYOUT_FAKE_OUTCOME=processing
# Module 39: not set here on purpose — the default is OFF in local / testing and ON everywhere else. Set it only to override.
# FINANCE_PAYOUT_FOUR_EYES=
# FINANCE_ADJUSTMENT_FOUR_EYES=
# Provider settlement reconciliation (reads the configured payment provider's settlement records).
FINANCE_PROVIDER_SETTLEMENT_EXPECTED_DAYS=5
FINANCE_PROVIDER_SETTLEMENT_PAGE_SIZE=200
FINANCE_PROVIDER_SETTLEMENT_LOOKBACK_DAYS=3
FINANCE_PROVIDER_RECONCILIATION_SCHEDULED=false
FINANCE_ORPHAN_PAYMENT_MINUTES=30
FINANCE_POSTING_GRACE_MINUTES=10
FINANCE_SWEEP_BATCH=200
FINANCE_RESTAURANT_TERMS_VISIBLE=true
FINANCE_METRICS_RETENTION_HOURS=48
# ----------------------------------------------------------------------------------------------------------------------
# Support cases (Module 37). ONE case domain for customers, restaurants, administrators and the system. A case
# coordinates work; it never changes an order, a payment, a refund or any money. Everything below is operating policy:
# DEVELOPMENT DEFAULTS, PENDING BUSINESS APPROVAL. No value here is a commitment to a customer or a restaurant.
# ----------------------------------------------------------------------------------------------------------------------
# How many cases that are still being worked on one customer / one restaurant member may have at a time (0 = no cap).
SUPPORT_OPEN_CASES_PER_REQUESTER=20
# Reopening by the requester: days after RESOLVED, and days after CLOSED (0 = a closed case is never reopened by them).
SUPPORT_REOPEN_RESOLVED_DAYS=14
SUPPORT_REOPEN_CLOSED_DAYS=7
# Closing by the clock. EMPTY = off (the default): nobody approved a number of days.
SUPPORT_AUTO_CLOSE_RESOLVED_DAYS=
SUPPORT_AUTO_CLOSE_NO_RESPONSE_DAYS=
# Internal SLA targets live in the table support_sla_policies (TEST fixtures locally). They are not a contract.
SUPPORT_SLA_AT_RISK_RATIO=0.8
SUPPORT_SLA_AUTO_ESCALATE=false
# Cases the system opens by itself, once per condition.
SUPPORT_SYSTEM_CASE_PAYMENT_RECOVERY=true
SUPPORT_SYSTEM_CASE_REFUND_REVIEW=true
SUPPORT_SYSTEM_CASE_DISPUTE=true
# The lowest severity of a reconciliation difference that opens a case (LOW | MEDIUM | HIGH | CRITICAL; empty = off).
SUPPORT_SYSTEM_CASE_DIFFERENCE_SEVERITY=HIGH
SUPPORT_SWEEP_BATCH=200
# Attachments are NOT BUILT (no upload endpoint, no private-file infrastructure, no malware scanner): "enabled" is a
# constant false in config/support.php, not a variable. The scanner name is recorded for the day they are built.
SUPPORT_ATTACHMENT_SCANNER=none
RATE_LIMIT_SUPPORT_READ=120
RATE_LIMIT_SUPPORT_CASE_CREATE=6
RATE_LIMIT_SUPPORT_WRITE=20
RATE_LIMIT_SUPPORT_ADMIN_ACTION=60
RATE_LIMIT_FINANCE_READ=120
RATE_LIMIT_FINANCE_ACTION=30
RATE_LIMIT_FINANCE_EXPORT=10

# ----------------------------------------------------------------------------------------------------------------
# Module 38 — analytics, reporting, exports. A read / aggregation layer; every value is a DEVELOPMENT DEFAULT,
# PENDING BUSINESS APPROVAL. No advertising tracker, no warehouse.
# ----------------------------------------------------------------------------------------------------------------
ANALYTICS_EVENTS_ENABLED=true
# Empty = derived from APP_KEY. Changing it starts new pseudonyms (a customer is a keyed hash in analytics).
ANALYTICS_PSEUDONYM_KEY=
# Fine-grained route rows built on fewer journeys than this are not shown.
ANALYTICS_MIN_COHORT=5
# A rate is shown only when its denominator is at least this.
ANALYTICS_MIN_DENOMINATOR=5
ANALYTICS_AGGREGATION_SCHEDULED=true
ANALYTICS_QUALITY_SCHEDULED=true
ANALYTICS_CACHE_ENABLED=true
ANALYTICS_CACHE_SECONDS=60
ANALYTICS_EXPORT_EXPIRY_HOURS=24
ANALYTICS_EXPORT_MAX_ROWS=50000
ANALYTICS_RAW_EVENT_DAYS=180
ANALYTICS_SESSION_DAYS=400
ANALYTICS_QUEUE=default
ANALYTICS_METRICS_RETENTION_HOURS=48
RATE_LIMIT_ANALYTICS_READ=120
RATE_LIMIT_ANALYTICS_EXPORT=10
RATE_LIMIT_ANALYTICS_INGEST=60
