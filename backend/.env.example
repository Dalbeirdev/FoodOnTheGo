# FoodOnTheGo backend — environment template. Copy to .env and fill in LOCAL values only.
# Never commit .env. Never put staging / production credentials in a local file.
# Business code reads config/*.php, never env() directly.

# ---------------------------------------------------------------- APP
APP_NAME=FoodOnTheGo
# local | testing | staging | production
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_VERSION=local-dev
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Comma separated browser origins allowed by CORS (first one is used in e-mail links).
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
# ISO 3166-1 alpha-2 code of the market used when a request names none.
MARKET_DEFAULT_COUNTRY=IN

# ---------------------------------------------------------------- LOGGING
LOG_CHANNEL=stack
# single (text, local) | structured (JSON lines, staging / production)
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------- DATABASE (PostgreSQL + PostGIS only)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=foodonthego_local
DB_USERNAME=fotg_local
DB_PASSWORD=
DB_SSLMODE=prefer

# ---------------------------------------------------------------- REDIS (cache, queues, rate limits, locks — never durable business data)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ---------------------------------------------------------------- CACHE / QUEUE / SESSION
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Module 32 — realtime order tracking: Laravel Reverb (WebSocket) is the broadcaster. The app id / key / secret are
# LOCAL random values you make up (never a production credential); the key is public to clients, the secret is not.
# Tests run with BROADCAST_CONNECTION=null (phpunit.xml). Start the server with: php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8085
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8085
# Comma-separated HOSTS (no scheme, no port — Reverb matches the Origin header's host) allowed to open a WebSocket. "*" is never used.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# ---------------------------------------------------------------- API
API_PAGE_SIZE=25
API_PAGE_SIZE_MAX=100
API_IDEMPOTENCY_TTL_MINUTES=1440
# true only in local / testing: exposes per-dependency readiness at /api/v1/ready without authentication.
API_READINESS_PUBLIC=true
# Requests per minute — development defaults, tune per environment.
RATE_LIMIT_API=120
RATE_LIMIT_PASSWORD_RESET=5
RATE_LIMIT_OTP_IP=10
RATE_LIMIT_OTP_PHONE=3
RATE_LIMIT_SEARCH=60
RATE_LIMIT_AVAILABILITY=30
RATE_LIMIT_PAYMENT=10
RATE_LIMIT_ADMIN_SENSITIVE=20

# ---------------------------------------------------------------- OTP (customer phone sign-in)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
# Fixed code for local / testing only, and only while nothing real is sent (SMS_DRIVER=log, no WhatsApp). Ignored in staging and production even if set.
OTP_DEV_CODE=

# ---------------------------------------------------------------- IDENTITY / SESSIONS
# Access-token lifetime in minutes (one token = one signed-in device).
AUTH_TOKEN_TTL_CUSTOMER_MINUTES=43200
AUTH_TOKEN_TTL_RESTAURANT_MINUTES=720
AUTH_TOKEN_TTL_ADMIN_MINUTES=480
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_INVITATION_TTL_HOURS=72
AUTH_PASSWORD_RESET_TTL_MINUTES=30
# true = an account without MFA can sign in only to enrol (set true for admin outside local).
AUTH_MFA_REQUIRED_ADMIN=false
AUTH_MFA_REQUIRED_RESTAURANT=false
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
AUTH_MFA_CHALLENGE_MAX_ATTEMPTS=5
# Password for the restaurant / admin fixture accounts created by db:seed in local / testing only.
# Empty = no fixture accounts. Choose your own value locally; never set it outside local.
LOCAL_FIXTURE_PASSWORD=
# Optional password source for `php artisan admin:create` when it runs unattended.
ADMIN_BOOTSTRAP_PASSWORD=
RATE_LIMIT_OTP_VERIFY_IP=20
RATE_LIMIT_OTP_VERIFY_CHALLENGE=10
RATE_LIMIT_STAFF_LOGIN_IP=20
RATE_LIMIT_STAFF_LOGIN_IDENTITY=5
RATE_LIMIT_ADMIN_LOGIN_IP=10
RATE_LIMIT_ADMIN_LOGIN_IDENTITY=3
RATE_LIMIT_MFA_VERIFY=10

# ---------------------------------------------------------------- MAIL
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@foodonthego.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------- STORAGE
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------- PROVIDERS (not integrated yet — leave empty)
# SMS for one-time codes. SMS_DRIVER: log | msg91 | twofactor | twilio
#   log       = NO SMS is sent (masked audit line only). Local / testing only; refused in production.
#   msg91     = MSG91 (India). Template + DLT id + sender are set up in the MSG91 panel.
#   twofactor = 2Factor.in (India). Template approved in their panel.
#   twilio    = Twilio (global). Text comes from OTP_SMS_TEMPLATE and must match the DLT template in India.
# SMS_FALLBACK_DRIVER: optional second provider used when the first cannot deliver.
# Check with: php artisan otp:check      Real test message: php artisan otp:test <phone> [--channel=sms|whatsapp]
SMS_DRIVER=log
SMS_FALLBACK_DRIVER=
SMS_TIMEOUT=10
SMS_MSG91_AUTH_KEY=
SMS_MSG91_OTP_TEMPLATE_ID=
SMS_2FACTOR_API_KEY=
SMS_2FACTOR_TEMPLATE=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_MESSAGING_SERVICE_SID=
SMS_TWILIO_FROM=
OTP_SMS_TEMPLATE="Your FoodOnTheGo verification code is :code. It expires in :minutes minutes. Do not share it with anyone."
# ---- How the one-time code reaches the customer (cheapest first). Resend moves to the next channel.
#   sms           = SMS only (default)
#   whatsapp,sms  = WhatsApp first, SMS on resend or when WhatsApp cannot deliver
OTP_CHANNELS=sms
# WhatsApp Cloud API (Meta). Template = an approved AUTHENTICATION template with a copy-code button.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
# Truecaller one-tap verification (Android app). Empty = off.
TRUECALLER_CLIENT_ID=
# MAPS / PLACES / ROUTING
MAPS_DRIVER=
MAPS_BROWSER_KEY=
PLACES_DRIVER=
PLACES_API_KEY=
ROUTING_DRIVER=
ROUTING_API_KEY=
# Module 26 journeys: fake = deterministic development providers (refused in production), google = live. Policy bounds in config/journey.php.
JOURNEY_ALLOW_FAKE_PROVIDERS=
JOURNEY_CORRIDOR_DEFAULT_METERS=3000
JOURNEY_SHORTLIST_CAP=40
JOURNEY_DETOUR_DEFAULT_MAX_MINUTES=15
JOURNEY_TTL_MINUTES=30
# Module 27 carts: lifetimes after the last change (hours), grace before the cleanup closes an expired cart (hours),
# retention of closed carts (days), how long a guest token may start a new cart (days), bounds. See config/cart.php.
CART_GUEST_TTL_HOURS=168
CART_CUSTOMER_TTL_HOURS=720
CART_EXPIRED_GRACE_HOURS=24
CART_CLOSED_RETENTION_DAYS=30
CART_GUEST_TOKEN_TTL_DAYS=30
CART_MAX_LINES=50
CART_MAX_TOTAL_QUANTITY=0
# Module 28 pickup availability (platform values; what a restaurant decides is its own pickup configuration).
# Large orders: the first FREE_ITEMS units add nothing, every further ITEMS_PER_STEP units add MINUTES_PER_STEP,
# up to MAX_EXTRA_MINUTES (0 minutes per step = off). Arrival buffer: minutes added to a traveller's estimated
# arrival before a time is recommended. See config/pickup.php.
PICKUP_PREP_QUANTITY_FREE_ITEMS=10
PICKUP_PREP_QUANTITY_ITEMS_PER_STEP=10
PICKUP_PREP_QUANTITY_MINUTES_PER_STEP=5
PICKUP_PREP_QUANTITY_MAX_EXTRA_MINUTES=30
PICKUP_PREP_MAX_MINUTES=480
PICKUP_ARRIVAL_BUFFER_MINUTES=0
PICKUP_CAPACITY_LIMITED_SHARE=0.25
PICKUP_MAX_SLOTS=600
PICKUP_REVALIDATE_AFTER_SECONDS=60
# Module 29 checkout: how long a checkout that is not confirmed lives (minutes), how long a confirmed one — and the
# pickup time it holds — lives (minutes), retention of closed checkouts (days), order-note length. TEST tax / fee
# rules are NEVER applied in production (APP_ENV=production), whatever is set here; elsewhere they are applied unless
# CHECKOUT_ALLOW_TEST_RULES=false. No tax or fee rate is configured here or anywhere in the code: rules are created
# by an administrator per market. See config/checkout.php.
CHECKOUT_DRAFT_TTL_MINUTES=15
CHECKOUT_READY_TTL_MINUTES=10
CHECKOUT_CLOSED_RETENTION_DAYS=30
CHECKOUT_ORDER_NOTE_MAX_LENGTH=300
CHECKOUT_ALLOW_TEST_RULES=
CHECKOUT_METRICS_RETENTION_HOURS=48
RATE_LIMIT_CHECKOUT_READ=120
RATE_LIMIT_CHECKOUT_WRITE=30
RATE_LIMIT_PROMOTION_APPLY=10
# Legal documents a customer accepts at checkout: the version in force and its effective date (YYYY-MM-DD). The texts
# are DRAFTS pending business / legal approval; whether a market's text is approved is market configuration.
LEGAL_TERMS_VERSION=draft-2026-09
LEGAL_TERMS_EFFECTIVE_DATE=
LEGAL_PRIVACY_VERSION=draft-2026-09
LEGAL_PRIVACY_EFFECTIVE_DATE=
LEGAL_REFUND_VERSION=draft-2026-09
LEGAL_REFUND_EFFECTIVE_DATE=
# PAYMENTS (Module 30). PAYMENT_DRIVER: razorpay | fake | empty. Empty = payments unavailable (there is no fallback).
# "fake" moves no money, exists for tests and local development, and is ALWAYS refused in production.
PAYMENT_DRIVER=
PAYMENT_TIMEOUT=15
PAYMENT_ALLOW_FAKE_PROVIDER=
PAYMENT_ATTEMPT_TTL_MINUTES=15
PAYMENT_HOLD_GRACE_MINUTES=5
PAYMENT_MAX_ATTEMPTS_PER_CHECKOUT=5
PAYMENT_WINDOW_MINUTES=45
PAYMENT_ORDER_HANDOFF_MINUTES=30
PAYMENT_WEBHOOK_QUEUE=payments
PAYMENT_DISPLAY_NAME=FoodOnTheGo
PAYMENT_METRICS_RETENTION_HOURS=48
# RAZORPAY — TEST MODE ONLY in this module (a live key is refused). Server-side secrets: never in a client, never committed.
# RAZORPAY_KEY_ID is the only value a browser or an app may see. Webhook URL: POST /api/v1/webhooks/payments/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
RAZORPAY_CAPTURE=automatic
RAZORPAY_METHODS=
RATE_LIMIT_PAYMENT_READ=120
RATE_LIMIT_PAYMENT_WEBHOOK=600
# FCM
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
# WEBSOCKET
WEBSOCKET_DRIVER=

# Notifications (Module 33). PUSH_DRIVER: fake (local, deterministic) | fcm (FCM HTTP v1 — FIREBASE_PROJECT_ID + FIREBASE_CREDENTIALS = absolute path of the
# git-ignored service-account JSON; never commit it) | off. EMAIL_NOTIFICATIONS_DRIVER: mail (Laravel mailer — MAIL_MAILER) | fake. SMS_NOTIFICATIONS_DRIVER: off | fake
# (no SMS provider is approved for notifications; the OTP SMS provider is separate). Nothing real is sent on a local machine.
PUSH_DRIVER=fake
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
FCM_RESTRICTED_PACKAGE_NAME=
EMAIL_NOTIFICATIONS_DRIVER=mail
SMS_NOTIFICATIONS_DRIVER=off
NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_DEFAULT_LOCALE=en-IN
