{
  "openapi": "3.1.0",
  "info": {
    "title": "FoodOnTheGo API",
    "version": "v1",
    "description": "Contract for /api/v1. Conventions: snake_case JSON; single resources are returned unwrapped; collections are {data, links, meta}; every error is {error: {code, message, details?, request_id}}; money is {amount, currency} with amount in integer minor units and an ISO 4217 currency; identifiers are public UUIDs (internal numeric ids are never exposed); timestamps are ISO 8601 in UTC; countries are ISO 3166-1 alpha-2; time zones are IANA ids. Every response carries X-Request-Id. tests/Feature/Foundation/OpenApiContractTest.php fails when the routes or the documented response shapes drift from this file."
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Public availability check (no infrastructure detail)",
        "responses": {
          "200": { "description": "Available", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } },
          "503": { "description": "Degraded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Per-dependency readiness. Public only in local / testing; otherwise requires admin.system.view",
        "security": [{ "bearer": [] }, {}],
        "responses": {
          "200": { "description": "Ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "503": { "description": "Not ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } } }
        }
      }
    },
    "/config": {
      "get": {
        "summary": "Client bootstrap configuration (safe values only)",
        "parameters": [{ "$ref": "#/components/parameters/Country" }],
        "responses": {
          "200": { "description": "Configuration", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClientConfig" } } } },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/markets/current": {
      "get": {
        "summary": "The market serving this client (default market, or ?country= when it serves customers)",
        "parameters": [{ "$ref": "#/components/parameters/Country" }],
        "responses": {
          "200": { "description": "Market", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Market" } } } },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/admin/markets": {
      "get": {
        "summary": "All markets in any status (admin.markets.view)",
        "security": [{ "bearer": [] }],
        "parameters": [
          { "name": "filter[status]", "in": "query", "schema": { "$ref": "#/components/schemas/MarketStatus" } },
          { "name": "filter[country_code]", "in": "query", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "description": "Comma list of name, country_code, status, created_at; prefix - for descending", "schema": { "type": "string" } },
          { "name": "page[number]", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "page[size]", "in": "query", "schema": { "type": "integer", "minimum": 1 } }
        ],
        "responses": {
          "200": { "description": "Page of markets", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarketPage" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "INTERIM (Module 03 prototype): password registration. Replaced by phone + OTP in the identity module",
        "responses": { "201": { "description": "Token and user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } }, "422": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "INTERIM (Module 03 prototype): password sign-in. Replaced by phone + OTP in the identity module",
        "responses": { "200": { "description": "Token and user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } }, "422": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/auth/forgot-password": {
      "post": { "summary": "INTERIM: request a password reset link", "responses": { "200": { "description": "Accepted (same answer whether or not the account exists)" }, "422": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } }
    },
    "/auth/reset-password": {
      "post": { "summary": "INTERIM: set a new password with a reset token", "responses": { "200": { "description": "Password changed" }, "422": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } }
    },
    "/auth/me": {
      "get": { "summary": "The authenticated principal", "security": [{ "bearer": [] }], "responses": { "200": { "description": "User", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/auth/profile": {
      "patch": { "summary": "Update own name, e-mail or phone", "security": [{ "bearer": [] }], "responses": { "200": { "description": "User", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } }, "401": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } }
    },
    "/auth/logout": {
      "post": { "summary": "Revoke the current token", "security": [{ "bearer": [] }], "responses": { "200": { "description": "Signed out" }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/auth/logout-all": {
      "post": { "summary": "Revoke every token of the principal", "security": [{ "bearer": [] }], "responses": { "200": { "description": "Signed out everywhere" }, "401": { "$ref": "#/components/responses/Error" } } }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "description": "Opaque Sanctum API token. Revocable server-side; stored hashed." }
    },
    "parameters": {
      "Country": { "name": "country", "in": "query", "required": false, "description": "ISO 3166-1 alpha-2, upper case", "schema": { "type": "string", "pattern": "^[A-Z]{2}$" } }
    },
    "responses": {
      "Error": { "description": "Error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "description": "Stable machine-readable code, e.g. validation_failed, unauthenticated, forbidden, not_found, conflict, rate_limited, internal_error, or a domain code such as market_unavailable" },
              "message": { "type": "string", "description": "Customer-safe text" },
              "details": { "type": "object", "description": "validation_failed: {fields: {name: [messages]}}; rate_limited: {retry_after_seconds}" },
              "request_id": { "type": "string" }
            }
          },
          "debug": { "type": "object", "description": "Only when APP_DEBUG is on (never in production)" }
        }
      },
      "Money": {
        "type": "object",
        "required": ["amount", "currency"],
        "additionalProperties": false,
        "properties": {
          "amount": { "type": "integer", "description": "Minor units (24900 = INR 249.00)" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status", "service", "version", "time"],
        "additionalProperties": false,
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "service": { "type": "string" },
          "version": { "type": "string" },
          "time": { "type": "string" }
        }
      },
      "Readiness": {
        "type": "object",
        "required": ["status", "environment", "checks", "version", "time"],
        "additionalProperties": false,
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "environment": { "type": "string" },
          "checks": {
            "type": "object",
            "required": ["application", "database", "postgis", "redis"],
            "additionalProperties": false,
            "properties": {
              "application": { "type": "string", "enum": ["ok", "error"] },
              "database": { "type": "string", "enum": ["ok", "error"] },
              "postgis": { "type": "string", "enum": ["ok", "error"] },
              "redis": { "type": "string", "enum": ["ok", "error"] }
            }
          },
          "version": { "type": "string" },
          "time": { "type": "string" }
        }
      },
      "MarketStatus": { "type": "string", "enum": ["DRAFT", "PILOT", "ACTIVE", "PAUSED", "CLOSED"] },
      "Market": {
        "type": "object",
        "required": ["id", "slug", "country_code", "name", "status", "default_currency", "supported_currencies", "default_locale", "supported_locales", "timezone_strategy", "default_timezone", "distance_unit", "phone_country_code", "features", "launched_at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "name": { "type": "string" },
          "status": { "$ref": "#/components/schemas/MarketStatus" },
          "default_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "supported_currencies": { "type": "array", "items": { "type": "string" } },
          "default_locale": { "type": "string" },
          "supported_locales": { "type": "array", "items": { "type": "string" } },
          "timezone_strategy": { "type": "string", "enum": ["single", "per-location"] },
          "default_timezone": { "type": "string", "description": "IANA time zone id" },
          "distance_unit": { "type": "string", "enum": ["metric", "imperial"] },
          "phone_country_code": { "type": "string", "description": "UX default for phone inputs, not a validation rule" },
          "features": { "type": "object", "description": "Feature key → enabled" },
          "launched_at": { "type": ["string", "null"] }
        }
      },
      "MarketPage": {
        "type": "object",
        "required": ["data", "links", "meta"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Market" } },
          "links": { "type": "object", "required": ["first", "last", "prev", "next"] },
          "meta": { "type": "object", "required": ["current_page", "per_page", "total", "last_page"] }
        }
      },
      "ClientConfig": {
        "type": "object",
        "required": ["api", "app", "market"],
        "additionalProperties": false,
        "properties": {
          "api": { "type": "object", "required": ["version"], "additionalProperties": false, "properties": { "version": { "type": "string" } } },
          "app": { "type": "object", "required": ["name", "version"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "version": { "type": "string" } } },
          "market": { "$ref": "#/components/schemas/Market" }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "name", "email", "email_verified", "phone", "phone_verified", "principal_type", "member_since", "last_login_at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": ["string", "null"] },
          "email_verified": { "type": "boolean" },
          "phone": { "type": ["string", "null"] },
          "phone_verified": { "type": "boolean" },
          "principal_type": { "type": "string", "enum": ["CUSTOMER", "RESTAURANT_USER", "ADMIN_USER"] },
          "member_since": { "type": ["string", "null"] },
          "last_login_at": { "type": ["string", "null"] }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": ["token", "token_type", "user"],
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string" },
          "token_type": { "type": "string", "enum": ["Bearer"] },
          "user": { "$ref": "#/components/schemas/User" }
        }
      }
    }
  }
}
