# FoodOnTheGo — PRODUCTION environment template (Module 39). NOT a working configuration: every secret is EMPTY on
# purpose and is set in the production secret store, never in a file in the repository. Settings not listed here take
# the values documented in .env.example. Before traffic is let in: `php artisan security:check` must pass.
#
# PRODUCTION = NO: no production environment exists yet (Modules 40–42). Values below are the security posture the
# Module 39 review requires; providers stay PENDING CONFIGURATION / PROVIDER VERIFICATION until set up.

APP_NAME=FoodOnTheGo
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.invalid
# Extra Host headers that may reach the application (comma-separated); APP_URL's host is always trusted.
TRUSTED_HOSTS=
# Addresses / CIDR ranges of the load balancer that may set X-Forwarded-* (empty = none trusted).
TRUSTED_PROXIES=
FRONTEND_URLS=https://www.example.invalid
# Browser origins allowed to open the realtime connection (never localhost in production).
REVERB_ALLOWED_ORIGINS=www.example.invalid

LOG_CHANNEL=stack
# One JSON line per entry, rotated daily (config/logging.php "structured"); the retention is PENDING BUSINESS APPROVAL.
LOG_STACK=structured
LOG_DAILY_DAYS=14
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full

REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

API_READINESS_PUBLIC=false

# Administrator MFA and four-eyes approval are ON by default outside local / testing; set them only to override.
# AUTH_MFA_REQUIRED_ADMIN=
# REFUND_FOUR_EYES=
# FINANCE_SETTLEMENT_FOUR_EYES=
# FINANCE_PAYOUT_FOUR_EYES=
# FINANCE_ADJUSTMENT_FOUR_EYES=
# PENDING BUSINESS APPROVAL (the default is 60).
AUTH_ADMIN_IDLE_MINUTES=60
RESTAURANT_CONTACT_HOURS=24
SECURITY_MAX_BODY_BYTES=262144

# Real providers only (the fake / log drivers are refused by security:check).
MAIL_MAILER=
SMS_DRIVER=
PUSH_DRIVER=fcm
PAYMENT_DRIVER=razorpay
PAYOUT_DRIVER=
PLACES_DRIVER=google
ROUTING_DRIVER=google

# Secrets (set in the secret store; never committed):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FIREBASE_CREDENTIALS=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
PLACES_API_KEY=
ROUTING_API_KEY=
ANALYTICS_PSEUDONYM_KEY=
