# FoodOnTheGo — PRODUCTION environment template (Module 39, completed in Module 41). NOT a working configuration:
# every secret is EMPTY on purpose and is set in the production secret store, never in a file in the repository.
#
# Module 41: this file lists EVERY setting a production deployment must decide. Do NOT fall back to .env.example for
# anything that is missing here — .env.example holds LOCAL development values (http, 127.0.0.1, log drivers, draft
# legal versions). A key that is not listed here and not set takes the default in config/*.php (the safe production
# value for the switches listed under "leave unset" at the end).
#
# Before traffic is let in: `php artisan security:check` must exit 0 (41 items).
# PRODUCTION = NO: no production environment exists yet (Module 42). Providers stay PENDING CONFIGURATION / PROVIDER
# VERIFICATION until set up. The full matrix with owners: docs/production/environment-matrix.md.

# ---------------------------------------------------------------- application
APP_NAME=FoodOnTheGo
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.invalid
# The release identifier shown by /health (commit or build number).
APP_VERSION=
# Maintenance mode shared by every host (the file driver covers one host only — REL-043).
APP_MAINTENANCE_DRIVER=cache
MARKET_DEFAULT_COUNTRY=IN
# Extra Host headers that may reach the application (comma-separated); APP_URL's host is always trusted.
TRUSTED_HOSTS=
# Addresses / CIDR ranges of the load balancer that may set X-Forwarded-* — REQUIRED behind a load balancer, or every
# per-IP rate limit becomes one shared bucket (security:check item 38).
TRUSTED_PROXIES=
# Exact https origins of Customer Web, Restaurant Dashboard and Platform Admin (comma-separated, no trailing slash).
FRONTEND_URLS=https://www.example.invalid
FRONTEND_URL=https://www.example.invalid
API_READINESS_PUBLIC=false

# ---------------------------------------------------------------- logging
LOG_CHANNEL=stack
# One JSON line per entry, rotated daily (config/logging.php "structured"); the retention is PENDING BUSINESS APPROVAL.
# Never slack / papertrail / syslog / errorlog: they do not carry the redaction tap.
LOG_STACK=structured
LOG_DAILY_DAYS=14
LOG_LEVEL=info
OBSERVABILITY_SERVER_TIMING=false
OBSERVABILITY_REQUEST_LOG=slow

# ---------------------------------------------------------------- PostgreSQL 16 + PostGIS (PostGIS created by the DBA)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
# The managed database's CA certificate (path on the host) for verify-full.
DB_SSLROOTCERT=
# With PgBouncer in transaction mode (CF-558, PENDING APPROVAL): named prepared statements off.
DB_PGSQL_DISABLE_PREPARES=true
DB_PERSISTENT=false

# ---------------------------------------------------------------- Redis (cache, rate limits, locks, queues, sessions)
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
# rediss:// when the Redis service requires TLS (then REDIS_HOST / PORT are taken from the URL).
REDIS_URL=
REDIS_PERSISTENT=false
CACHE_STORE=redis
# The queue on Redis (owner to confirm against the "Redis cache-only" decision — CF-575); maxmemory-policy noeviction.
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=90

# ---------------------------------------------------------------- sessions (two web routes only; the API is bearer-only)
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ---------------------------------------------------------------- realtime (Laravel Reverb behind a TLS proxy)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# The public wss host / port the clients and the API use.
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
# Where the Reverb process listens behind the proxy.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Browser origin HOSTS allowed to open the realtime connection (never localhost or *). The Android app sends no
# Origin header by default — see CF-576 before go-live.
REVERB_ALLOWED_ORIGINS=www.example.invalid
REVERB_SCALING_ENABLED=false
REVERB_APP_RATE_LIMITING_ENABLED=true

# ---------------------------------------------------------------- authentication and security posture
# Administrator MFA and four-eyes approval are ON by default outside local / testing; set them only to override.
# AUTH_MFA_REQUIRED_ADMIN=
# REFUND_FOUR_EYES=
# FINANCE_SETTLEMENT_FOUR_EYES=
# FINANCE_PAYOUT_FOUR_EYES=
# FINANCE_ADJUSTMENT_FOUR_EYES=
# PENDING BUSINESS APPROVAL (the default is 60).
AUTH_ADMIN_IDLE_MINUTES=60
# PENDING BUSINESS DECISION: MFA for restaurant staff.
AUTH_MFA_REQUIRED_RESTAURANT=false
RESTAURANT_CONTACT_HOURS=24
SECURITY_MAX_BODY_BYTES=262144

# ---------------------------------------------------------------- payments (Razorpay) — LIVE stays off in code (Module 30)
PAYMENT_DRIVER=razorpay
# test | live — must match the key id prefix (rzp_test_ / rzp_live_); a mismatch is refused.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# No live payout adapter exists: settlements are paid outside the platform until approved (CF-498).
PAYOUT_DRIVER=

# ---------------------------------------------------------------- places / routing (Google)
PLACES_DRIVER=google
ROUTING_DRIVER=google
PLACES_API_KEY=
ROUTING_API_KEY=

# ---------------------------------------------------------------- OTP sign-in (India: DLT-registered sender and template)
# msg91 | twofactor | twilio (+ the provider's keys and template ids, see .env.example "SMS" for the key names).
SMS_DRIVER=
OTP_CHANNELS=sms
OTP_SMS_TEMPLATE=

# ---------------------------------------------------------------- notifications
PUSH_DRIVER=fcm
FIREBASE_PROJECT_ID=
# Path of the mounted service-account JSON file (a secret file; never committed).
FIREBASE_CREDENTIALS=
FCM_RESTRICTED_PACKAGE_NAME=com.foodonthego.app
EMAIL_NOTIFICATIONS_DRIVER=mail
# No SMS provider is approved for order notifications.
SMS_NOTIFICATIONS_DRIVER=off

# ---------------------------------------------------------------- mail (staff invitations, password reset, notification e-mail)
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=FoodOnTheGo

# ---------------------------------------------------------------- storage (one host, or storage/app on SHARED storage — CF-560)
FILESYSTEM_DISK=local
MENU_IMAGE_DISK=public
CUSTOMER_AVATAR_DISK=public
ANALYTICS_EXPORT_DISK=local

# ---------------------------------------------------------------- analytics
ANALYTICS_PSEUDONYM_KEY=
# PENDING: consent decision (CF-528).
ANALYTICS_EVENTS_ENABLED=true

# ---------------------------------------------------------------- legal (APPROVED versions only — security:check item 41)
LEGAL_TERMS_VERSION=
LEGAL_TERMS_EFFECTIVE_DATE=
LEGAL_PRIVACY_VERSION=
LEGAL_PRIVACY_EFFECTIVE_DATE=
LEGAL_REFUND_VERSION=
LEGAL_REFUND_EFFECTIVE_DATE=

# ---------------------------------------------------------------- leave UNSET (the defaults are the safe production values)
# PAYMENT_ALLOW_FAKE_PROVIDER, JOURNEY_ALLOW_FAKE_PROVIDERS, CHECKOUT_ALLOW_TEST_RULES, NOTIFICATIONS_ADMIN_TEST_ENABLED,
# ORDER_CUSTOMER_CANCELLATION_ENABLED, REFUND_AUTO_APPROVE_*, FINANCE_SETTLEMENTS_SCHEDULED (until approved).
# MUST NOT EXIST in production: LOCAL_FIXTURE_PASSWORD, OTP_DEV_CODE, ADMIN_BOOTSTRAP_PASSWORD (except for the one
# `php artisan admin:create` run that creates the first administrator; security:check item 40).
