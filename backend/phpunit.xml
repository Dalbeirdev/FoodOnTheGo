        <env name="EMAIL_NOTIFICATIONS_DRIVER" value="fake"/>
        <env name="SMS_NOTIFICATIONS_DRIVER" value="fake"/>
        <env name="FIREBASE_CREDENTIALS" value=""/>
        <!-- Module 32: the realtime signing driver in tests (no server runs; these are test values, not credentials) -->
        <env name="REVERB_APP_ID" value="100001"/>
        <env name="REVERB_APP_KEY" value="test-reverb-key"/>
        <env name="REVERB_APP_SECRET" value="test-reverb-secret"/>
