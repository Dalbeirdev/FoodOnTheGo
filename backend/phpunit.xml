        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="API_READINESS_PUBLIC" value="true" force="true"/>
        <env name="MARKET_DEFAULT_COUNTRY" value="IN" force="true"/>
        <env name="OTP_DEV_CODE" value="123456" force="true"/>
