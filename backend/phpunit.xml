<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Tests run against real PostgreSQL + PostGIS (dedicated database) and real Redis (dedicated
            logical databases), never SQLite: database-specific behaviour must not be hidden by another engine.
            Host and credentials come from the local .env; create the database with scripts/local/setup-database.ps1.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="true" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="foodonthego_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="REDIS_DB" value="14" force="true"/>
        <env name="REDIS_CACHE_DB" value="15" force="true"/>
        <env name="REDIS_QUEUE" value="testing" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="API_READINESS_PUBLIC" value="true" force="true"/>
        <env name="MARKET_DEFAULT_COUNTRY" value="IN" force="true"/>
        <env name="OTP_DEV_CODE" value="123456" force="true"/>
        <env name="SMS_DRIVER" value="log" force="true"/>
        <env name="SMS_FALLBACK_DRIVER" value="" force="true"/>
        <env name="OTP_CHANNELS" value="sms" force="true"/>
        <env name="WHATSAPP_ACCESS_TOKEN" value="" force="true"/>
        <env name="WHATSAPP_PHONE_NUMBER_ID" value="" force="true"/>
        <env name="WHATSAPP_OTP_TEMPLATE" value="" force="true"/>
        <env name="TRUECALLER_CLIENT_ID" value="" force="true"/>
        <env name="OTP_SMS_TEMPLATE" value="Your FoodOnTheGo verification code is :code. It expires in :minutes minutes. Do not share it with anyone." force="true"/>
        <env name="OTP_LENGTH" value="6" force="true"/>
        <env name="OTP_TTL_SECONDS" value="300" force="true"/>
        <env name="OTP_MAX_ATTEMPTS" value="5" force="true"/>
        <env name="OTP_RESEND_COOLDOWN_SECONDS" value="30" force="true"/>
        <env name="OTP_MAX_SENDS_PER_HOUR" value="5" force="true"/>
        <env name="RATE_LIMIT_API" value="120" force="true"/>
        <env name="RATE_LIMIT_OTP_IP" value="10" force="true"/>
        <env name="RATE_LIMIT_OTP_PHONE" value="3" force="true"/>
        <env name="RATE_LIMIT_OTP_VERIFY_IP" value="20" force="true"/>
        <env name="RATE_LIMIT_OTP_VERIFY_CHALLENGE" value="10" force="true"/>
        <env name="RATE_LIMIT_STAFF_LOGIN_IP" value="20" force="true"/>
        <env name="RATE_LIMIT_STAFF_LOGIN_IDENTITY" value="5" force="true"/>
        <env name="RATE_LIMIT_ADMIN_LOGIN_IP" value="10" force="true"/>
        <env name="RATE_LIMIT_ADMIN_LOGIN_IDENTITY" value="3" force="true"/>
        <env name="RATE_LIMIT_MFA_VERIFY" value="10" force="true"/>
        <env name="RATE_LIMIT_PASSWORD_RESET" value="5" force="true"/>
        <env name="AUTH_TOKEN_TTL_CUSTOMER_MINUTES" value="43200" force="true"/>
        <env name="AUTH_TOKEN_TTL_RESTAURANT_MINUTES" value="720" force="true"/>
        <env name="AUTH_TOKEN_TTL_ADMIN_MINUTES" value="480" force="true"/>
        <env name="AUTH_PASSWORD_MIN_LENGTH" value="12" force="true"/>
        <env name="AUTH_PASSWORD_RESET_TTL_MINUTES" value="30" force="true"/>
        <env name="AUTH_MFA_REQUIRED_ADMIN" value="false" force="true"/>
        <env name="AUTH_MFA_REQUIRED_RESTAURANT" value="false" force="true"/>
        <env name="AUTH_MFA_CHALLENGE_TTL_SECONDS" value="300" force="true"/>
        <env name="AUTH_MFA_CHALLENGE_MAX_ATTEMPTS" value="5" force="true"/>
        <env name="LOCAL_FIXTURE_PASSWORD" value="fixture-password-for-tests" force="true"/>
        <env name="ADMIN_BOOTSTRAP_PASSWORD" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
